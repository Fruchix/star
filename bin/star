star_mode_rename() {
    if [[ $# -lt 2 ]]; then
        err "star rename: missing argument(s)."
        usage_rename
        return 1
    fi
    local rename_src rename_dst
    rename_src="${1//\//${star_dir_separator}}"
    rename_dst="${2//\//${star_dir_separator}}"


    local res
    if [[ ! -e "${DATAPATH_STARS}/${rename_src}" ]]; then
        err "star rename: Star ${COLOR_STAR}${rename_src}${COLOR_RESET} does not exist."
        return 1
    fi

    # TODO: remove the environment variable corresponding to the old name

    # if names are the same except their case then try to bypass using temporary rename
    # case sensitive renaming can fail because of file systems, or even mv resolving symlinks instead of renaming them
    if [[ "$(echo "${rename_src}" | tr '[:upper:]' '[:lower:]')" == "$(echo "${rename_dst}" | tr '[:upper:]' '[:lower:]')" ]]; then
        # try to find a random temporary name that does not exist without using tools like mktemp (less dependencies)
        local random_suffix_attempts=3
        local random_suffix="$RANDOM"
        while [[ -e "${DATAPATH_STARS}/${rename_dst}.${random_suffix}" && $random_suffix_attempts -gt 0 ]]; do
            random_suffix="$random_suffix$RANDOM"
            ((random_suffix_attempts--))
        done

        # temporary rename
        if ! mv "${DATAPATH_STARS}/${rename_src}" "${DATAPATH_STARS}/${rename_dst}.${random_suffix}"; then
            res=$?
            err "star rename: Failed to rename star ${COLOR_STAR}${rename_src//${star_dir_separator}//}${COLOR_RESET} to temporary name ${COLOR_STAR}${rename_dst//${star_dir_separator}//}.${random_suffix}${COLOR_RESET}."
            err "star rename: This temporary name is because the two names are the same except for case, and would have been renamed to the final name ${COLOR_STAR}${rename_dst//${star_dir_separator}//}${COLOR_RESET}."

            # TODO: add environment variable back
            return $res
        fi

        # final rename
        if ! mv "${DATAPATH_STARS}/${rename_dst}.${random_suffix}" "${DATAPATH_STARS}/${rename_dst}"; then
            res=$?
            # if final rename failed, try to revert it
            if ! mv "${DATAPATH_STARS}/${rename_dst}.${random_suffix}" "${DATAPATH_STARS}/${rename_src}"; then
                res=$?
                err "star rename: Failed to rename star from temporary name ${COLOR_STAR}${rename_dst//${star_dir_separator}//}.${random_suffix}${COLOR_RESET} to final name ${COLOR_STAR}${rename_dst//${star_dir_separator}//}${COLOR_RESET}."
                err "star rename: This temporary rename was used because the two names were the same except for the case. The temporary rename worked, but the final rename AND it revert to original name both failed."
                err "star rename: Good luck, bye!"
                return $res
            else
                err "star rename: Failed to rename star ${COLOR_STAR}${rename_src//${star_dir_separator}//}${COLOR_RESET} to ${COLOR_STAR}${rename_dst//${star_dir_separator}//}${COLOR_RESET}."
                # TODO: add environment variable back
                return $res
            fi
        fi

        out "Renamed star ${COLOR_STAR}${rename_src//${star_dir_separator}//}${COLOR_RESET} to ${COLOR_STAR}${rename_dst//${star_dir_separator}//}${COLOR_RESET}."
        # TODO: add environment variable back
        return 0
    fi

    # else if the old and new names are different, use a classic mv

    if [[ -e "${DATAPATH_STARS}/${rename_dst}" ]]; then
        err "star rename: There is already a star named ${COLOR_STAR}${rename_dst}${COLOR_RESET}."
        # TODO: add old environment variable back
        return 2
    fi

    if ! mv "${DATAPATH_STARS}/${rename_src}" "${DATAPATH_STARS}/${rename_dst}"; then
        res=$?
        err "star rename: Failed to rename star ${COLOR_STAR}${rename_src//${star_dir_separator}//}${COLOR_RESET} to ${COLOR_STAR}${rename_dst//${star_dir_separator}//}${COLOR_RESET}."
        # TODO: add old environment variable back
        return $res
    fi

    out "Renamed star ${COLOR_STAR}${rename_src//${star_dir_separator}//}${COLOR_RESET} to ${COLOR_STAR}${rename_dst//${star_dir_separator}//}${COLOR_RESET}."
    # TODO: add new environment variable back

    return 0
}

star_mode_remove() {
    if [[ $# -lt 1 ]]; then
        err "star remove: missing argument(s)."
        usage_remove
        return 1
    fi
    local stars_to_remove=()
    # remove multiple stars
    while [[ $# -gt 0 ]]; do
        stars_to_remove+=("$(replace_slashes_by_separator "$1")")
        shift
    done

    local star_name
    if [[ ! -d "${DATAPATH_STARS}" || -z "$(ls -A "${DATAPATH_STARS}" )" ]];then
        err "star remove: there are no starred directories to remove."
        return 1
    fi

    # remove all env variables while their paths are still known
    # _star_unset_variables

    for star_name in "${stars_to_remove[@]}"; do
        if [[ -e "${DATAPATH_STARS}/${star_name}" ]]; then
            if ! rm "${DATAPATH_STARS}/${star_name}"; then
                local res=$?
                err "star remove: Failed to remove starred directory: ${COLOR_STAR}${star_name//${star_dir_separator}//}${COLOR_RESET}."
                return $res
            fi
            out "Removed starred directory: ${COLOR_STAR}${star_name//${star_dir_separator}//}${COLOR_RESET}."
        else
            err "star remove: Could not find any starred directory with the name: ${COLOR_STAR}${star_name//${star_dir_separator}//}${COLOR_RESET}."
            return 1
        fi
    done
    # re create the other environment variables
    # _star_set_variables
}

