# in case there are more arguments and it happens to be help option
check_help_option_provided() {
    local mode="$1"

    shift
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == "-h" || "$1" == "--help" ]]; then
            usage_"$mode"
            return 0
        fi
        shift
    done
}

check_wrapper_function_initialized() {
    # check if a star function was initialized (had to be exported like 'export -f <function>')
    declare -F | grep "^declare -fx star$" > /dev/null
}


### main ###

main() {
    if [[ $# -eq 0 ]]; then
        usage >&2
        return 1
    fi

    # set necessary env vars (functions will not overwrite if already defined)
    set_star_home
    set_star_config_home
    set_star_config_file
    set_star_data_home

    # parse the mode
    local arg_mode=$1
    shift
    case $arg_mode in
        init)               star_mode_init "$@" ;;
        add)                star_mode_add "$@"  ;;
        L|list)             star_mode_list "$@" ;;
        l|load)             star_mode_load "$@" ;;
        mv|rename)          star_mode_rename "$@" ;;
        rm|remove)          star_mode_remove "$@" ;;
        reset)              star_mode_reset "$@" ;;
        config)             star_mode_config "$@" ;;
        h|help|-h|--help)   star_mode_help "$@" ;;
        -v|--version)       star_mode_version "$@" ;;
        -I|--info)          star_mode_info "$@";;
        *)
            err "star: invalid mode '$arg_mode'"
            usage >&2
            return 1
            ;;
    esac
}

main "$@"